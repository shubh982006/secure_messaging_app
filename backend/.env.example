# --- Signal Clone backend configuration -------------------------------------
# Copy to .env and adjust. Every value has a working default for local dev.

# SQLite (default). Swap for Postgres with zero code changes:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/signal
DATABASE_URL=sqlite+aiosqlite:///./signal.db

# HS256 signing key. MUST be overridden in any deployed environment.
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma separated list, or * for "any origin" (dev only).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed demo users/conversations on boot when the DB is empty.
SEED_ON_STARTUP=true

# Mocked OTP - the code every request-otp returns.
MOCK_OTP_CODE=123456
OTP_EXPIRE_SECONDS=300

# message.send rate limit (per user)
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=10

MAX_MESSAGE_LENGTH=8192

# --- attachments -------------------------------------------------------------
# Uploads are written here and served from /media. In production point this at a
# persistent volume (the same one as signal.db).
MEDIA_ROOT=media
MAX_UPLOAD_BYTES=10485760

# --- disappearing messages ---------------------------------------------------
# How often the sweeper hard-deletes lapsed messages. Expiry is enforced at
# query time regardless, so this only controls how quickly rows are reclaimed.
DISAPPEAR_SWEEP_SECONDS=20
